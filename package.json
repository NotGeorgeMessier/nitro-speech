{
  "name": "react-native-nitro-speech",
  "version": "0.4.9",
  "description": "React Native real-time Speech Recognition Library powered by Nitro Modules",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "reinstall": "rm -rf node_modules && bun install",
    "build": "rm -rf lib && rm -f tsconfig.tsbuildinfo && bun tsc && bun run lint:lib",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint:lib": "eslint \"lib/**/*.{js,ts,tsx}\" --fix",
    "nitro": "rm -rf nitrogen && npx nitrogen@latest",
    "localnitro": "rm -rf nitrogen && node ../../../nitro/nitro/packages/nitrogen/lib/index.js",
    "docs:start": "npm --prefix website start",
    "docs:build": "npm --prefix website run build",
    "test": "npm --prefix apps/example test",
    "test:harness:android": "npm --prefix apps/example run test:harness:android",
    "test:harness:ios": "npm --prefix apps/example run test:harness:ios",
    "test:ios:native": "bash scripts/test-ios-native.sh",
    "test:android:native": "bash scripts/test-android-native.sh",
    "example": "npm --prefix apps/example",
    "example:start": "npm --prefix apps/example start",
    "example:android": "npm --prefix apps/example run android",
    "example:ios": "npm --prefix apps/example run ios"
  },
  "keywords": [
    "react-native",
    "speech",
    "recognition",
    "speech-recognition",
    "speech-to-text",
    "SpeechAnalyzer",
    "SpeechTranscriber",
    "DictationTranscriber",
    "stt",
    "voice",
    "voice-recognition",
    "transcription",
    "transcriber",
    "audio",
    "microphone",
    "nitro",
    "nitro-modules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotGeorgeMessier/nitro-speech.git"
  },
  "bugs": {
    "url": "https://github.com/NotGeorgeMessier/nitro-speech/issues"
  },
  "author": "George Messier",
  "homepage": "https://github.com/NotGeorgeMessier/nitro-speech#readme",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.87.1",
    "@types/react": "19.2.14",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-nitro-modules": "0.37.1",
    "nitrogen": "0.37.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "*.js"
        ],
        "parserOptions": {
          "requireConfigFile": false,
          "babelOptions": {
            "configFile": false,
            "babelrc": false,
            "presets": []
          }
        }
      },
      {
        "files": [
          "lib/**/*.js"
        ],
        "parser": "@typescript-eslint/parser",
        "plugins": [
          "@typescript-eslint"
        ],
        "rules": {
          "@typescript-eslint/no-unused-vars": [
            "error",
            {
              "argsIgnorePattern": "^_",
              "destructuredArrayIgnorePattern": "^_"
            }
          ],
          "no-unused-vars": "off",
          "no-shadow": "off",
          "@typescript-eslint/no-shadow": 1,
          "no-undef": "off"
        }
      }
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "apps/",
    "nitrogen/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  }
}
